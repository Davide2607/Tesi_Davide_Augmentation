      "source": [
        "IMG_SHAPE = (128,128,3)\n",
        "NOISE_DIM = 100\n",
        "BATCH_SIZE = 64\n",
        "LR_C = 5e-5\n",
        "LR_G = 2e-4\n",
        "BETA1 = 0.5\n",
        "LAMBDA_GP = 20\n",
        "CRITIC_STEPS = 4"
      ]
